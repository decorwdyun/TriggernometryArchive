region 配置：通用选项&#xD;&#xA;&#xD;&#xA;        #region 配置：文本频道&#xD;&#xA;        OptionsTableLayoutPanel tableChannel = form.AddOptionGroup(&quot; 文本频道 &quot;);&#xD;&#xA;        var cnlPublicItems = new BijectDictionary&lt;string, string&gt;(&#xD;&#xA;            (&quot;p&quot;, &quot; 小队&quot;), (&quot;e&quot;, &quot; 默语&quot;)&#xD;&#xA;        );&#xD;&#xA;        var cnlDebugItems = new BijectDictionary&lt;string, string&gt;(&#xD;&#xA;            (&quot;&quot;, &quot; 禁用&quot;), (&quot;e&quot;, &quot; 默语&quot;)&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        OptionCbx cnlPublic = new OptionCbx(&quot;　公共频道&quot;, &quot;cnlPublic&quot;, cnlPublicItems, &quot;e&quot;,&#xD;&#xA;            hint: &quot;本频道作为播报部分机制、示意图、复盘信息等机制相关内容的默认频道。\n\n默认设为仅自己可见的默语频道，\n如有需要可设为小队等。&quot;);&#xD;&#xA;        OptionCbx cnlDebug = new OptionCbx(&quot;　调试频道&quot;, &quot;cnlDebug&quot;, cnlDebugItems, &quot;&quot;,&#xD;&#xA;            hint: &quot;本频道用于发送调试信息，默认不需要启用。\n\n如果你在参与测试，请设置为自己可见的频道。&quot;);&#xD;&#xA;        form.AddOptions(tableChannel, cnlPublic, cnlDebug);&#xD;&#xA;        #endregion 配置：文本频道&#xD;&#xA;&#xD;&#xA;        #region 使用须知&#xD;&#xA;&#xD;&#xA;        OptionsTableLayoutPanel tableInfo = form.AddOptionGroup(&quot; 使用须知 &quot;);&#xD;&#xA;        form.AddLabel(&quot;· 使用前必须查看使用说明，见绝伊甸触发器分组下的「使用说明」触发器。&quot;, tableInfo)&#xD;&#xA;            .ForeColor = Blue;&#xD;&#xA;&#xD;&#xA;        label = form.AddLabel(&quot;· 下方部分选项上悬停鼠标可以显示详细说明。&quot;, tableInfo);&#xD;&#xA;        label.ForeColor = Blue;&#xD;&#xA;&#xD;&#xA;        #endregion 使用须知&#xD;&#xA;&#xD;&#xA;        #region 配置：队员顺序&#xD;&#xA;        if (BridgeFFXIV.ZoneID == 1238 &amp;&amp; Triggernometry.FFXIV.Entity.GetEntities().Any(e =&gt; e.InParty))&#xD;&#xA;        {&#xD;&#xA;            string[] playerDescriptions = { &quot;MT&quot;, &quot;ST&quot;, &quot;H1&quot;, &quot;H2&quot;, &quot;D1&quot;, &quot;D2&quot;, &quot;D3&quot;, &quot;D4&quot; };&#xD;&#xA;            var pListPanel = new PartyListPanel(playerDescriptions);&#xD;&#