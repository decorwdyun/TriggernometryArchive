<ActionPlaceholder Desc="延迟咏唱" DescBackColor="acf" DescTextColor="248" DescOverride="True" />
<ActionPlaceholder Desc="　异步延迟执行 tts、蜂鸣声、指令 等动作。" DescBackColor="f0f8ff" DescTextColor="234" DescOverride="True" />
<ActionPlaceholder Desc="关于" DescBackColor="acf" DescTextColor="248" DescOverride="True" />
<ActionPlaceholder Desc="　作者：MnFeN 阿洛" DescBackColor="f0f8ff" DescTextColor="234" DescOverride="True" />
