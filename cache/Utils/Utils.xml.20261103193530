 0, 0, 0xE0000000, 0);&#xD;&#xA;&#xD;&#xA;    public void HandleActorControl(uint objectId, ushort category, uint a1, uint a2, uint a3, uint a4, uint a5, uint a6, uint a7, uint a8, uint targetId, uint unk)&#xD;&#xA;    {&#xD;&#xA;        if (HandleActorControlFuncPtr == IntPtr.Zero)&#xD;&#xA;            return;&#xD;&#xA;        _ = Plugin.Call&lt;IntPtr&gt;(HandleActorControlFuncPtr, objectId, category, a1, a2, a3, a4, a5, a6, a7, a8, targetId, unk);&#xD;&#xA;    }&#xD;&#xA;}">
